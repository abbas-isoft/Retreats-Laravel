<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\TestBooking;
use Stripe\Webhook;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Mail;

class StripeWebhookController extends Controller
{
    public function handle(Request $request)
    {
        $payload   = $request->getContent();
        $sigHeader = $request->header('Stripe-Signature');
        $secret    = config('services.stripe.webhook_secret');

        try {
            $event = Webhook::constructEvent($payload, $sigHeader, $secret);
        } catch (\UnexpectedValueException $e) {
            return response('Invalid payload', 400);
        } catch (\Stripe\Exception\SignatureVerificationException $e) {
            return response('Invalid signature', 400);
        }

        $type = $event->type;
        $obj  = $event->data->object;

        /**
         * ✅ Checkout Session Completed
         */
        if ($type === 'checkout.session.completed') {
            $session   = $obj;
            $bookingId = $session->metadata->local_booking_id ?? null;

            if ($bookingId) {
                $booking = TestBooking::find($bookingId);
                if ($booking) {
                    if (!empty($session->payment_intent)) {
                        $paymentIntent = \Stripe\PaymentIntent::retrieve($session->payment_intent);

                        $booking->update([
                            'payment_status'            => 'paid',
                            'stripe_payment_method_id'  => $paymentIntent->payment_method,
                            'upfront_payment_intent_id' => $paymentIntent->id,
                        ]);
                    } else {
                        $booking->update([
                            'payment_status' => 'paid',
                        ]);
                    }
                }
            }
        }

        /**
         * ✅ Payment Intent Succeeded
         */
        if ($type === 'payment_intent.succeeded') {
            $pi        = $obj;
            $bookingId = $pi->metadata->local_booking_id ?? null;
            $typeMeta  = $pi->metadata->type ?? null;

            if ($bookingId) {
                $booking = TestBooking::find($bookingId);
                if ($booking) {
                    if (!empty($pi->payment_method)) {
                        $booking->stripe_payment_method_id = $pi->payment_method;
                    }

                    if ($typeMeta === 'upfront') {
                        $booking->payment_status = ($booking->remaining_cents > 0) ? 'upfront_paid' : 'fully_paid';
                        $booking->upfront_payment_intent_id = $pi->id;
                    } elseif ($typeMeta === 'remaining') {
                        $booking->remaining_payment_intent_id = $pi->id;
                        $booking->payment_status = 'fully_paid';
                    } elseif ($typeMeta === 'deposit_hold' || $typeMeta === 'deposit_charge') {
                        $booking->damage_deposit_intent_id = $pi->id;
                    }

                    $booking->save();

                    try {
                        Mail::to($booking->email)->send(new \App\Mail\BookingConfirmed($booking));
                        Mail::to('enquiries@groupretreats.co.uk')->send(new \App\Mail\NewBookingNotification($booking));
                    } catch (\Exception $e) {
                        Log::error("Mail send failed for booking {$booking->id}: {$e->getMessage()}");
                    }
                }
            }
        }

        /**
         * ❌ Payment Failed
         */
        if ($type === 'payment_intent.payment_failed') {
            $pi        = $obj;
            $bookingId = $pi->metadata->local_booking_id ?? null;

            if ($bookingId) {
                $booking = TestBooking::find($bookingId);
                if ($booking) {
                    $booking->payment_status = 'failed';
                    $booking->save();
                }
            }
        }

        /**
         * 🟢 Deposit Released
         */
        if ($type === 'payment_intent.canceled') {
            $intent  = $obj;
            $booking = TestBooking::where('damage_deposit_intent_id', $intent->id)->first();
            if ($booking) {
                $booking->update(['damage_deposit_intent_id' => null]);
            }
        }

        /**
         * 🟠 Deposit Hold Update
         */
        if ($type === 'payment_intent.amount_capturable_updated') {
            $intent  = $obj;
            $booking = TestBooking::where('damage_deposit_intent_id', $intent->id)->first();
            if ($booking) {
                Log::info("Deposit hold active for booking {$booking->id}");
            }
        }

        return response('OK', 200);
    }
}
